{
  "name": "blitsen-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "packages/platforms/*"
  ],
  "scripts": {
    "check": "bun test packages/blitsen",
    "site:build": "bun run site/build/main.ts",
    "site:check": "bun run site/build/check.ts",
    "site:serve": "SITE_BASE= bun run site/build/main.ts && bunx serve site/dist"
  }
}
