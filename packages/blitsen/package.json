{
  "name": "blitsen",
  "version": "0.1.3",
  "description": "Native runtime CLI and types for Blitsen",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krazyjakee/blitsen.git",
    "directory": "packages/blitsen"
  },
  "homepage": "https://github.com/krazyjakee/blitsen#readme",
  "bugs": "https://github.com/krazyjakee/blitsen/issues",
  "keywords": [
    "desktop",
    "html",
    "css",
    "quickjs",
    "blitz"
  ],
  "bin": {
    "blitsen": "bin/blitsen.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./bundler": {
      "types": "./src/bundler.d.ts",
      "import": "./src/bundler.mjs"
    },
    "./config.schema.json": "./src/config.schema.json",
    "./tsconfig.json": "./tsconfig.json",
    "./dom": {
      "types": "./src/dom.d.ts"
    },
    "./app": {
      "types": "./src/native/app.d.ts",
      "import": "./src/native/app.mjs"
    },
    "./window": {
      "types": "./src/native/window.d.ts",
      "import": "./src/native/window.mjs"
    },
    "./dialog": {
      "types": "./src/native/dialog.d.ts",
      "import": "./src/native/dialog.mjs"
    },
    "./clipboard": {
      "types": "./src/native/clipboard.d.ts",
      "import": "./src/native/clipboard.mjs"
    },
    "./tray": {
      "types": "./src/native/tray.d.ts",
      "import": "./src/native/tray.mjs"
    },
    "./notify": {
      "types": "./src/native/notify.d.ts",
      "import": "./src/native/notify.mjs"
    },
    "./input": {
      "types": "./src/native/input.d.ts",
      "import": "./src/native/input.mjs"
    },
    "./os": {
      "types": "./src/native/os.d.ts",
      "import": "./src/native/os.mjs"
    }
  },
  "types": "./index.d.ts",
  "optionalDependencies": {
    "@blitsen/darwin-arm64": "0.1.3",
    "@blitsen/darwin-x64": "0.1.3",
    "@blitsen/linux-arm64": "0.1.3",
    "@blitsen/linux-x64": "0.1.3",
    "@blitsen/win32-arm64": "0.1.3",
    "@blitsen/win32-x64": "0.1.3"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "index.d.ts",
    "index.mjs",
    "src",
    "tsconfig.json"
  ],
  "scripts": {
    "api:sync": "bun src/api-manifest.mjs",
    "example:canvas": "bun test/run-canvas.mjs",
    "example:hardware": "bun test/run-hardware.mjs",
    "example:hello": "bun test/run-hello-dom.mjs",
    "example:interactive": "bun test/run-interactive.mjs",
    "example:native-view": "bun test/run-native-view.mjs",
    "example:pong": "bun test/run-pong.mjs",
    "example:todo": "bun test/run-todo.mjs",
    "record:pong": "bun test/record-pong-demo.mjs",
    "bench": "bun test/run-benchmarks.mjs",
    "bench:windowed": "bun test/run-benchmarks.mjs --windowed",
    "frames": "bun test/run-frame-metrics.mjs",
    "frames:audit": "bun test/run-frame-metrics.mjs --alloc-audit",
    "measure": "bun test/measure-export.mjs",
    "size:baseline": "bun test/run-size-gate.mjs --update",
    "size:gate": "bun test/run-size-gate.mjs",
    "size:phase2": "bun test/run-phase2-size.mjs",
    "size:android": "bun test/run-android-size.mjs",
    "test": "bun test",
    "test:determinism": "bun test/run-determinism.mjs",
    "golden:record": "bun test/run-determinism.mjs --update",
    "test:conformance": "cargo test -p blitsen-blitz --test conformance",
    "conformance:record": "BLITSEN_RECORD_CONFORMANCE=1 cargo test -p blitsen-blitz --test conformance",
    "conformance:capture": "bun ../../crates/blitsen-blitz/tests/conformance/capture.mjs",
    "test:native": "bun test/run-native-harness.mjs",
    "test:m2": "bun test/run-m2.mjs",
    "test:bundlers": "bun test/run-bundlers.mjs",
    "test:m3b": "bun test/run-m3b.mjs",
    "test:hosts": "bun test/run-host-conformance.mjs",
    "test:third-party": "bun test/run-third-party.mjs",
    "test:types": "bun test/run-types.mjs",
    "test:standalone": "bun test/run-standalone.mjs",
    "notices": "bun test/generate-notices.mjs",
    "test:licensing": "bun test/run-redistribution.mjs",
    "test:proxy": "bun test/run-proxy.mjs",
    "test:android": "bun test/run-android-smoke.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
